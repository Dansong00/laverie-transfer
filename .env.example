# Copy to .env.local for Next.js. Never commit .env or .env.local.
# No real values belong in this file. Preview environments use their own
# database and test-only secrets. Do not reuse production credentials.

# Postgres connection string.
# Local: postgresql://laverie:laverie@127.0.0.1:5432/laverie
# Neon: use the pooled host and sslmode=require.
# Preview must not point at the production database.
DATABASE_URL=

# Signs or encrypts the session cookie. Unique per environment.
SESSION_SECRET=

# Custom header sent exactly as entered in Cents. Test-only on previews.
# Do not point the live Cents webhook at a preview URL.
CENTS_WEBHOOK_HEADER_NAME=
CENTS_WEBHOOK_HEADER_SECRET=

# App store id to Cents store id, recorded at go-live.
CENTS_STORE_ALLOWLIST=

# E.164 number for the one-time first admin. Test-only on previews.
BOOTSTRAP_ADMIN_PHONE=

# Sign-in texts. Provider choice is an implementation detail.
SMS_PROVIDER_API_KEY=
SMS_FROM=

# Production domain used in the SMS template @<app domain> #<code>.
APP_DOMAIN=

# Public origin of this environment.
APP_BASE_URL=

# Spec defaults. Override per environment if Daniel changes them.
SESSION_MAX_DAYS=30
SESSION_IDLE_DAYS=7
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
BOARD_POLL_SECONDS=45
